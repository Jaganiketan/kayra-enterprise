rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "nXHIW6ntWCZilxyxoupg9kgATsy2";
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "customerName","name","phone","mobile","productName","product",
          "productId","quantity","price","total","amount","status","createdAt"
        ])
        && request.resource.data.status == "pending"
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 100
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read, update, delete: if isAdmin();
    }

    match /customers/{id} {
      // Customer may create only an opted-in marketing record.
      allow create: if
        request.resource.data.keys().hasOnly([
          "name","phone","whatsapp","marketingConsent","consentAt","source","createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.marketingConsent == true
        && request.resource.data.source == "website_popup";
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
